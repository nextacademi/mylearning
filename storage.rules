rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function role() { return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role; }
    function admin() { return signedIn() && (role() == 'Admin' || role() == 'Director'); }
    function teacher() { return signedIn() && role() == 'Teacher'; }
    function documentMeta(docId) { return firestore.get(/databases/(default)/documents/documents/$(docId)).data; }
    function ownsDocument(docId) {
      return teacher() && (
        documentMeta(docId).teacherId == request.auth.uid ||
        (documentMeta(docId).teacherIds is list && request.auth.uid in documentMeta(docId).teacherIds)
      );
    }
    // Cross-service Storage->Firestore role lookups (role()/admin() above)
    // are not resolving in this project's Storage Rules runtime — even a
    // bare firestore.exists() check on the caller's own user doc is denied,
    // independent of the Firestore rules, the field name, or the Blaze
    // billing plan (all verified). A hardcoded thumbnail-admin UID allowlist
    // used to work around this here, but it silently breaks the moment that
    // UID's account is deleted/recreated and needs a redeploy for every new
    // Admin/Director. Course thumbnails are now uploaded server-side via
    // /api/admin/training/thumbnail (Admin SDK) instead, same as
    // academyEvents/banner, products/image, etc. below — no client write
    // path is needed or allowed here at all.

    // A user's own profile photo. Authorization is pure path matching on
    // `request.auth.uid == uid` — no cross-service Firestore lookup, so it
    // works reliably from Storage Rules here (the same reason the direct
    // chat-media block below authorizes by path, not by firestore.get()).
    // Any signed-in user may upload/replace only their own avatar; anyone
    // may read (avatars are shown across the app). Client-uploaded, then
    // the resulting download URL is written to users/{uid}.photoURL by
    // lib/profile-data.js.
    match /users/{uid}/avatar/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    match /documents/{docId}/{fileName} {
      allow read: if admin() || ownsDocument(docId);
      allow write, delete: if admin() || ownsDocument(docId);
    }
    match /courses/{courseId}/thumbnail/{fileName} {
      allow read: if true;
      allow write, delete: if false;
    }
    // Chat media. conversationId is already deterministic — two sorted
    // participant UIDs joined by "_" (see lib/chat-data.js) — so
    // authorization here is pure string matching on the path itself,
    // never a firestore.get() lookup, which is the one mechanism verified
    // above to be unreliable from Storage Rules in this project. This is
    // deliberate, not an oversight: Admin/Director do NOT get a blanket
    // bypass on chat media (unlike Firestore's conversations/messages
    // rules, which are same-service and unaffected) — they can only reach
    // a conversation's media by actually being one of its two participants.
    match /chat/{conversationId}/{messageId}/{fileName} {
      allow read, delete: if signedIn() && request.auth.uid in conversationId.split('_');
      allow create: if signedIn() && request.auth.uid in conversationId.split('_')
        && request.resource.size < 100 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|audio/.*|video/.*');
    }
    // Group chat photos. A group's conversationId is a random Firestore doc
    // ID (not a deterministic sorted-participant join like a direct
    // conversation's), so the chat/{conversationId}/... path-based trick
    // below can't authorize this the same way, and a Firestore membership
    // check from here hits the same broken cross-service lookup documented
    // above. Uploaded server-side via /api/chat/group-photo instead (Admin
    // SDK, verifies the caller is one of the group's groupAdminIds with a
    // same-service Firestore read) — no client write path needed or allowed.
    match /chat-groups/{conversationId}/photo/{fileName} {
      allow read: if true;
      allow write, delete: if false;
    }
    // Event banners — same reasoning as course thumbnails above: uploaded
    // server-side via /api/admin/events/banner using the Admin SDK, which
    // re-verifies Admin/Director via a same-service Firestore read before
    // it touches Storage, so no client write path is needed or allowed here.
    match /academyEvents/{eventId}/banner/{fileName} {
      allow read: if true;
      allow write, delete: if false;
    }
    // My Shop product images — same reasoning and pattern as the event
    // banner block above: uploaded server-side via
    // /api/admin/shop/products/image using the Admin SDK, which
    // re-verifies Admin/Director with a same-service Firestore read
    // before touching Storage, so no client write path is needed here.
    match /products/{productId}/image/{fileName} {
      allow read: if true;
      allow write, delete: if false;
    }
    // Category images — same reasoning as products above.
    match /productCategories/{categoryId}/image/{fileName} {
      allow read: if true;
      allow write, delete: if false;
    }
    // Certificate template backgrounds — same reasoning as products/events:
    // Storage Rules can't reliably cross-reference Firestore roles here, so
    // all writes go through the Admin-SDK-proxied upload route and the
    // object is made public at upload time; the client never writes here.
    match /certificateTemplates/{templateId}/{fileName} {
      allow read: if true;
      allow write, delete: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
