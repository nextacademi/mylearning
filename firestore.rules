rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function role(value) { return signedIn() && profile().role == value; }
    function admin() { return role('Admin') || role('Director'); }
    function teacher() { return role('Teacher'); }
    function ownsClass(classId) { return teacher() && exists(/databases/$(database)/documents/classes/$(classId)) && get(/databases/$(database)/documents/classes/$(classId)).data.teacherIds.hasAny([request.auth.uid]); }
    function ownsCourse(courseId) { return teacher() && exists(/databases/$(database)/documents/courses/$(courseId)) && get(/databases/$(database)/documents/courses/$(courseId)).data.teacherIds.hasAny([request.auth.uid]); }
    function assignedStudent(studentId) { return teacher() && exists(/databases/$(database)/documents/users/$(studentId)) && get(/databases/$(database)/documents/users/$(studentId)).data.role == 'Student' && get(/databases/$(database)/documents/users/$(studentId)).data.teacherIds.hasAny([request.auth.uid]); }
    // Requires enrollments/{courseId}_{studentId}; see the data-contract migration note.
    function enrolledInCourse(courseId) { return signedIn() && exists(/databases/$(database)/documents/enrollments/$(courseId + '_' + request.auth.uid)) && get(/databases/$(database)/documents/enrollments/$(courseId + '_' + request.auth.uid)).data.studentId == request.auth.uid && get(/databases/$(database)/documents/enrollments/$(courseId + '_' + request.auth.uid)).data.status != 'withdrawn'; }
    function enrolledInClass(classId) { return signedIn() && exists(/databases/$(database)/documents/classes/$(classId)) && enrolledInCourse(get(/databases/$(database)/documents/classes/$(classId)).data.courseId) && get(/databases/$(database)/documents/enrollments/$(get(/databases/$(database)/documents/classes/$(classId)).data.courseId + '_' + request.auth.uid)).data.classId == classId; }

    match /users/{userId} {
      // `userId` (the unified, human-readable YYYYMMDD+4-digit User ID —
      // lib/server/user-id.js) is always minted server-side via the Admin
      // SDK, never by a client write: a self-registering client may not
      // set it on create, and nobody (not even the account owner) may
      // change it afterward, same as `uid`/`role`.
      allow create: if admin() || (signedIn() && request.auth.uid == userId && request.resource.data.uid == userId && request.resource.data.role == 'Student' && !('userId' in request.resource.data) && (!('status' in request.resource.data) || request.resource.data.status == 'active'));
      allow read: if signedIn() && (request.auth.uid == userId || admin() || (resource.data.role == 'Student' && resource.data.teacherIds.hasAny([request.auth.uid])));
      allow update: if admin() || (signedIn() && request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid', 'role', 'teacherIds', 'active', 'qrVersion', 'status', 'userId']));
      allow delete: if admin();
    }
    match /classes/{classId} {
      allow read: if admin() || (teacher() && resource.data.teacherIds.hasAny([request.auth.uid])) || enrolledInClass(classId);
      allow create: if admin() || (teacher() && request.resource.data.teacherIds.hasOnly([request.auth.uid]) && ownsCourse(request.resource.data.courseId));
      allow update: if admin() || (ownsClass(classId) && request.resource.data.teacherIds == resource.data.teacherIds && request.resource.data.courseId == resource.data.courseId);
      allow delete: if admin() || ownsClass(classId);
    }
    match /enrollments/{enrollmentId} {
      allow read: if admin() || ownsClass(resource.data.classId) || (signedIn() && resource.data.studentId == request.auth.uid);
      allow create: if admin() || (teacher() && ownsClass(request.resource.data.classId) && ownsCourse(request.resource.data.courseId) && get(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.courseId == request.resource.data.courseId && enrollmentId == request.resource.data.courseId + '_' + request.resource.data.studentId);
      allow update: if admin() || (ownsClass(resource.data.classId) && ownsClass(request.resource.data.classId) && resource.data.studentId == request.resource.data.studentId && resource.data.courseId == request.resource.data.courseId && resource.data.classId == request.resource.data.classId);
      allow delete: if admin() || ownsClass(resource.data.classId);
    }
    // Payment ledger for admissions. All writes happen server-side via the
    // Admin SDK (/api/admin/payments), which bypasses these rules — this
    // block only governs direct client reads/writes. Students may read
    // (never write) only their own payment records; Teacher gets no access
    // at all (falls through to the catch-all deny below), matching the
    // "Teacher should not see financial data" requirement.
    match /payments/{paymentId} {
      allow read: if admin() || (signedIn() && resource.data.studentId == request.auth.uid);
      allow write: if admin();
    }
    // Academy expenses (Finance module). Admin-only in every direction —
    // no student/teacher access of any kind, unlike payments which students
    // may read their own copy of. All writes happen server-side via
    // /api/admin/expenses (Admin SDK), which bypasses these rules; this
    // block only governs direct client access attempts.
    match /expenses/{expenseId} {
      allow read, write: if admin();
    }
    // Manual academy income (Finance → Income) — registration/event fees,
    // donations, and other non-tuition money in. Admin/Director only, same
    // as expenses. Every mutation happens server-side via
    // /api/admin/finance/income (Admin SDK), which bypasses these rules and
    // sets createdBy from the verified token; this block only backstops
    // direct client access attempts. Kept separate from `payments` so a
    // manually-logged donation is never mistaken for a student tuition
    // payment or applied to an outstanding balance.
    match /finance_income/{incomeId} {
      allow read, write: if admin();
    }
    // Manual (non-enrollment) invoices — Registration/Material/Exam Fee
    // etc. Course-fee invoices are NOT stored here at all; the enrollment
    // doc itself is that invoice (see the `enrollments` block above), so
    // this collection only ever holds invoices with no backing enrollment.
    // Every mutation happens server-side via /api/admin/invoices (Admin
    // SDK); this block only governs direct client access. The invoice's
    // own student may read (never write) their own, same as `enrollments`
    // and `payments` above.
    match /invoices/{invoiceId} {
      allow read: if admin() || (signedIn() && resource.data.studentId == request.auth.uid);
      allow write: if admin();
    }
    // Asset register (Finance → Assets) — what the academy owns and its
    // value (furniture, equipment, deposits, renovation). Same
    // admin-only, server-SDK-only pattern as expenses/finance_income
    // above; this block only backstops direct client access attempts.
    match /assets/{assetId} {
      allow read, write: if admin();
    }
    match /courses/{courseId} {
      allow read: if admin() || (teacher() && resource.data.teacherIds.hasAny([request.auth.uid])) || enrolledInCourse(courseId);
      allow create: if admin() || (teacher() && request.resource.data.teacherIds.hasOnly([request.auth.uid]));
      allow update: if admin() || (ownsCourse(courseId) && request.resource.data.teacherIds == resource.data.teacherIds);
      allow delete: if admin() || ownsCourse(courseId);
      match /modules/{moduleId} {
        allow read: if admin() || ownsCourse(courseId) || enrolledInCourse(courseId);
        allow write: if admin() || ownsCourse(courseId);
        match /lessons/{lessonId} {
          allow read: if admin() || ownsCourse(courseId) || enrolledInCourse(courseId);
          allow write: if admin() || ownsCourse(courseId);
          match /completions/{studentUid} {
            allow read: if admin() || ownsCourse(courseId) || (signedIn() && request.auth.uid == studentUid);
            allow create, update: if signedIn() && request.auth.uid == studentUid && enrolledInCourse(courseId);
            allow delete: if admin() || ownsCourse(courseId);
          }
        }
      }
    }
    match /assignments/{assignmentId} {
      allow read: if admin() || (teacher() && resource.data.teacherId == request.auth.uid) || enrolledInClass(resource.data.classId);
      allow create: if admin() || (teacher() && request.resource.data.teacherId == request.auth.uid && ownsClass(request.resource.data.classId) && ownsCourse(request.resource.data.courseId));
      allow update: if admin() || (teacher() && resource.data.teacherId == request.auth.uid && request.resource.data.teacherId == resource.data.teacherId && request.resource.data.classId == resource.data.classId && request.resource.data.courseId == resource.data.courseId);
      allow delete: if admin() || (teacher() && resource.data.teacherId == request.auth.uid);
    }
    match /submissions/{submissionId} {
      allow read: if admin() || (teacher() && resource.data.teacherId == request.auth.uid) || (signedIn() && resource.data.studentId == request.auth.uid);
      allow create: if admin() || (teacher() && request.resource.data.teacherId == request.auth.uid && ownsClass(request.resource.data.classId)) || (signedIn() && request.resource.data.studentId == request.auth.uid && exists(/databases/$(database)/documents/assignments/$(request.resource.data.assignmentId)) && get(/databases/$(database)/documents/assignments/$(request.resource.data.assignmentId)).data.classId == request.resource.data.classId && enrolledInClass(request.resource.data.classId));
      allow update: if admin() || (teacher() && resource.data.teacherId == request.auth.uid) || (signedIn() && resource.data.studentId == request.auth.uid && request.resource.data.studentId == resource.data.studentId && request.resource.data.assignmentId == resource.data.assignmentId && request.resource.data.score == resource.data.score);
      allow delete: if admin() || (teacher() && resource.data.teacherId == request.auth.uid) || (signedIn() && resource.data.studentId == request.auth.uid);
    }
    match /attendance/{attendanceId} {
      allow read: if admin() || (teacher() && resource.data.teacherId == request.auth.uid) || (signedIn() && resource.data.studentId == request.auth.uid);
      allow create: if admin() || (teacher() && request.resource.data.teacherId == request.auth.uid && ownsClass(request.resource.data.classId) && assignedStudent(request.resource.data.studentId));
      allow update: if admin() || (teacher() && resource.data.teacherId == request.auth.uid && request.resource.data.teacherId == resource.data.teacherId && request.resource.data.classId == resource.data.classId && request.resource.data.studentId == resource.data.studentId);
      allow delete: if admin() || (teacher() && resource.data.teacherId == request.auth.uid);
    }
    // A single dated/timed physical meeting of an existing class/batch
    // (`classes/{classId}` already models the recurring batch — a session
    // is one specific occurrence of it, which nothing in the existing
    // schema modeled ahead of time). Reuses the exact same ownsClass()/
    // enrolledInClass() helpers every other class-scoped collection here
    // already uses — no new authorization primitive.
    match /classSessions/{sessionId} {
      allow read: if admin() || ownsClass(resource.data.classId) || enrolledInClass(resource.data.classId);
      allow create: if admin() || ownsClass(request.resource.data.classId);
      allow update, delete: if admin() || ownsClass(resource.data.classId);
    }
    match /events/{eventId} {
      allow read: if admin() || (teacher() && resource.data.teacherId == request.auth.uid) || (signedIn() && resource.data.classId != '' && enrolledInClass(resource.data.classId));
      allow create: if admin() || (teacher() && request.resource.data.teacherId == request.auth.uid && (request.resource.data.classId == '' || ownsClass(request.resource.data.classId)));
      allow update: if admin() || (teacher() && resource.data.teacherId == request.auth.uid && request.resource.data.teacherId == resource.data.teacherId && (request.resource.data.classId == '' || ownsClass(request.resource.data.classId)));
      allow delete: if admin() || (teacher() && resource.data.teacherId == request.auth.uid);
    }
    // Org-wide Event Management module (workshops, orientations, CSR, etc.)
    // — distinct from `events/{eventId}` above, which is each Teacher's own
    // per-class reminder list and must not be touched by this feature.
    // Every mutation (create/update/delete/publish, registration,
    // attendance) happens server-side via /api/admin/events and
    // /api/events/* using the Admin SDK, which bypasses these rules —
    // capacity/deadline/duplicate checks need a transaction and a
    // subcollection count, neither of which a security rule can do safely.
    // These rules are the direct-client-access backstop: Admin/Director get
    // full read/write, everyone else gets read-only on published events
    // (and their own participant record), and nobody gets a client write
    // path at all, so a Student can never create/edit/delete/publish an
    // event or another participant's registration/attendance no matter what
    // the app code does.
    match /academyEvents/{eventId} {
      // The `published == true` branch has no signedIn() guard on purpose:
      // it's what lets the public (signed-out) landing page's Event
      // Calendar section read the same academyEvents collection the
      // Director/Admin dashboard manages, live, with no separate public
      // collection and no server API route. It only ever exposes docs the
      // dashboard has explicitly published — drafts/unpublished events are
      // still fully invisible to a public visitor.
      allow read: if resource.data.published == true || admin() || (signedIn() && resource.data.organizerId == request.auth.uid);
      allow write: if admin();
      match /participants/{userId} {
        allow read: if admin() || (signedIn() && request.auth.uid == userId);
        allow write: if admin();
      }
    }
    // AI Assistant audit trail (spec section 17). All writes happen
    // server-side via /api/ai-assistant/audit (Admin SDK), which attaches
    // the verified userId/userRole/timestamp itself — never trusted from
    // the client — so this rule only governs direct client access
    // attempts: Admin/Director see everything, everyone else only their
    // own entries, and nobody has a client write path at all.
    match /aiAuditLog/{logId} {
      allow read: if admin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow write: if admin();
    }
    match /achievements/{achievementId} { allow read: if admin() || (teacher() && resource.data.teacherId == request.auth.uid) || (signedIn() && resource.data.studentId == request.auth.uid); allow create: if admin() || (teacher() && request.resource.data.teacherId == request.auth.uid && assignedStudent(request.resource.data.studentId)); allow update, delete: if admin() || (teacher() && resource.data.teacherId == request.auth.uid && request.resource.data.teacherId == resource.data.teacherId); }
    match /assessments/{assessmentId} { allow read: if admin() || (teacher() && resource.data.teacherId == request.auth.uid) || (signedIn() && resource.data.studentId == request.auth.uid); allow create: if admin() || (teacher() && request.resource.data.teacherId == request.auth.uid && assignedStudent(request.resource.data.studentId)); allow update, delete: if admin() || (teacher() && resource.data.teacherId == request.auth.uid && request.resource.data.teacherId == resource.data.teacherId); }
    match /certificates/{certificateId} { allow read: if admin() || (teacher() && resource.data.teacherId == request.auth.uid) || (signedIn() && resource.data.studentId == request.auth.uid); allow create: if admin() || (teacher() && request.resource.data.teacherId == request.auth.uid && assignedStudent(request.resource.data.studentId)); allow update, delete: if admin() || (teacher() && resource.data.teacherId == request.auth.uid && request.resource.data.teacherId == resource.data.teacherId); }
    // Quiz/Exam module. The quiz doc itself never carries correct answers
    // (those live in the answerKey subcollection below, teacher/admin-only,
    // never student-readable). Only the owning Teacher (or admin()) may
    // write a quiz or its answer key.
    match /quizzes/{quizId} {
      // `read` covers both get() AND list() — a list() rule can't reliably
      // use a cross-collection get() (confirmed empirically: ownsCourse()/
      // enrolledInCourse(), which each read() another collection, cause
      // permission-denied on a list() query even when the check would pass
      // for a single get()) — so read/update/delete are self-contained
      // checks against the quiz's own (denormalized) teacherId field, same
      // pattern as achievements/assessments/certificates above. A published
      // quiz's questions carry no correct answers, so opening read to any
      // signed-in user (not just enrolled students) costs nothing real —
      // the actual enrollment check that matters (can this person submit a
      // graded attempt?) is enforced server-side in
      // /api/exams/[quizId]/submit, which every submission must go through
      // anyway (see quizAttempts below). Only `create` — a single-document
      // write, where nothing on the new doc can be trusted yet — needs the
      // cross-collection ownsCourse() check.
      allow read: if admin() || (teacher() && resource.data.teacherId == request.auth.uid) || (signedIn() && resource.data.status == 'published');
      allow create: if admin() || (teacher() && ownsCourse(request.resource.data.courseId) && request.resource.data.teacherId == request.auth.uid);
      allow update, delete: if admin() || (teacher() && resource.data.teacherId == request.auth.uid);
      // `teacherId` is denormalized onto the answerKey doc itself too (same
      // reasoning as above — never a cross-document get() of the sibling
      // quiz doc, which also wouldn't see it yet within the same batch a
      // quiz is created in).
      match /answerKey/{keyId} {
        allow read, delete: if admin() || (teacher() && resource.data.teacherId == request.auth.uid);
        allow create, update: if admin() || (teacher() && ownsCourse(request.resource.data.courseId) && request.resource.data.teacherId == request.auth.uid);
      }
    }
    // Grading must never trust the client — a student attempt is only ever
    // created/scored server-side (Admin SDK, see /api/exams/[quizId]/submit),
    // which is why there is no client `create`/`update` allowance here at
    // all, only read of one's own attempt (or the owning teacher's / admin's).
    match /quizAttempts/{attemptId} {
      allow read: if admin() || resource.data.studentId == request.auth.uid || (teacher() && resource.data.teacherId == request.auth.uid);
      allow write: if admin();
    }
    match /conversations/{conversationId} {
      // `resource == null` (the doc doesn't exist yet) must be allowed here —
      // starting a new conversation does a client-side getDoc() first to
      // decide create-vs-reuse, and dereferencing resource.data on a null
      // resource otherwise throws permission-denied instead of a clean
      // "not found," breaking that check for every non-admin caller. No data
      // is exposed by allowing this — a nonexistent doc has none.
      //
      // Chat was originally restricted to a Teacher and one of their
      // assigned Students. Per the "New Chat: pick any registered user"
      // requirement, direct 1:1 chat is now open between any two signed-in
      // users — the assignedStudent()/teacherIds relationship check below
      // was deliberately dropped for `create`. Group chat is new: creation
      // is Admin/Director/Teacher only (teacher() branch below; admin()
      // already covers Admin/Director), management is restricted to
      // groupAdminIds, and any member may leave by removing only themself.
      allow read: if admin() || resource == null || (signedIn() && request.auth.uid in resource.data.participantIds);
      allow create: if admin()
        || (request.resource.data.type != 'group' && signedIn() && request.resource.data.participantIds.size() == 2 && request.auth.uid in request.resource.data.participantIds)
        || (request.resource.data.type == 'group' && teacher() && request.resource.data.createdBy == request.auth.uid && request.auth.uid in request.resource.data.participantIds && request.resource.data.groupAdminIds.hasAny([request.auth.uid]) && request.resource.data.participantIds.size() >= 2 && request.resource.data.participantIds.size() <= 100);
      allow update: if admin()
        // Direct 1:1 — any participant may update shared fields (lastMessage/
        // unreadCount/hiddenFor) but never participantIds/teacherId/studentId.
        // resource.data.get('type','direct') (not resource.data.type) because
        // every conversation created before this change has no `type` field
        // at all — a bare .data.type there throws on those existing docs
        // instead of falling through, which would otherwise silently break
        // sending a message in any conversation started before today.
        || (resource.data.get('type', 'direct') != 'group' && signedIn() && request.auth.uid in resource.data.participantIds && request.resource.data.participantIds == resource.data.participantIds && request.resource.data.teacherId == resource.data.teacherId && request.resource.data.studentId == resource.data.studentId)
        // Group — any current member sending a message may update shared
        // fields, but never membership, identity, or group profile fields.
        || (resource.data.get('type', 'direct') == 'group' && signedIn() && request.auth.uid in resource.data.participantIds && request.resource.data.participantIds == resource.data.participantIds && request.resource.data.participantNames == resource.data.participantNames && request.resource.data.participantRoles == resource.data.participantRoles && request.resource.data.groupName == resource.data.groupName && request.resource.data.groupPhoto == resource.data.groupPhoto && request.resource.data.groupDescription == resource.data.groupDescription && request.resource.data.groupAdminIds == resource.data.groupAdminIds && request.resource.data.createdBy == resource.data.createdBy)
        // Group admin — rename/change photo/description/add or remove any
        // member/promote-demote admins. Identity fields stay immutable.
        || (resource.data.get('type', 'direct') == 'group' && signedIn() && request.auth.uid in resource.data.groupAdminIds && request.resource.data.type == 'group' && request.resource.data.createdBy == resource.data.createdBy && request.resource.data.participantIds.size() <= 100)
        // Any group member leaving voluntarily — may only remove themself.
        || (resource.data.get('type', 'direct') == 'group' && signedIn() && request.auth.uid in resource.data.participantIds && !(request.auth.uid in request.resource.data.participantIds) && request.resource.data.participantIds.size() == resource.data.participantIds.size() - 1 && request.resource.data.type == 'group' && request.resource.data.createdBy == resource.data.createdBy);
      allow delete: if admin() || (teacher() && resource.data.teacherId == request.auth.uid);
      match /messages/{messageId} {
        allow read: if admin() || (signedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds);
        // Direct messages must name a real receiver among the participants
        // (unchanged). Group messages instead carry no `receiverId` at all —
        // unread/read tracking for groups lives only in the conversation
        // doc's unreadCount map, not per-message, since a group message has
        // many possible readers, not one. .get('type','direct') again, for
        // the same pre-existing-conversation reason as above.
        allow create: if admin() || (signedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds && request.resource.data.senderId == request.auth.uid && (request.resource.data.receiverId in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds || (get(/databases/$(database)/documents/conversations/$(conversationId)).data.get('type', 'direct') == 'group' && !('receiverId' in request.resource.data))) && (!('type' in request.resource.data) || request.resource.data.type in ['text', 'image', 'audio', 'video', 'file']));
        // The sender may edit/remove their own message; the receiver may
        // only flip `readAt` (nothing else) to mark it read — required for
        // the read-receipt feature, since a receiver is never the sender.
        // (Group messages have no single receiver, so this branch never
        // applies to them — their unread state is tracked on the
        // conversation doc instead.)
        allow update: if admin() || (signedIn() && resource.data.senderId == request.auth.uid) || (signedIn() && resource.data.receiverId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']) && request.resource.data.senderId == resource.data.senderId && request.resource.data.receiverId == resource.data.receiverId && request.resource.data.body == resource.data.body);
        allow delete: if admin() || (signedIn() && resource.data.senderId == request.auth.uid);
      }
    }
    // LMS Documents / Learning Materials. The whole module now reads and
    // writes exclusively through /api/documents + /api/documents/folders
    // (Admin SDK, which bypasses these rules). That server layer is the
    // single place visibility is decided — always against the AUTHENTICATED
    // user's real role + enrollment/assignment data
    // (lib/server/documents-core.js's canAccessDocument), so a Student can
    // never reach a Draft, an archived doc, another course's private
    // material, or another student's document by changing an id in the
    // request. There is deliberately NO direct client path: a Student can't
    // even getDoc() a document by guessing its id.
    match /documents/{documentId} {
      allow read, write: if false;
    }
    match /documentFolders/{folderId} {
      allow read, write: if false;
    }
    match /promotionLinks/{linkId} {
      allow read: if admin() || (teacher() && resource.data.teacherId == request.auth.uid);
      allow create: if admin() || (teacher() && request.resource.data.teacherId == request.auth.uid && ownsCourse(request.resource.data.courseId));
      allow update: if admin() || (teacher() && resource.data.teacherId == request.auth.uid && request.resource.data.teacherId == resource.data.teacherId && request.resource.data.courseId == resource.data.courseId);
      allow delete: if admin() || (teacher() && resource.data.teacherId == request.auth.uid);
    }
    match /promotionLeads/{leadId} {
      allow read: if admin() || (teacher() && resource.data.teacherId == request.auth.uid);
      allow create, update, delete: if admin();
    }
    match /notifications/{notificationId} { allow read, update, delete: if admin() || (signedIn() && resource.data.userId == request.auth.uid); allow create: if admin() || (signedIn() && request.resource.data.userId == request.auth.uid) || (teacher() && assignedStudent(request.resource.data.userId)) || (role('Student') && profile().teacherIds.hasAny([request.resource.data.userId])); }
    match /activities/{activityId} { allow read: if admin() || (teacher() && resource.data.teacherId == request.auth.uid) || (signedIn() && resource.data.actorId == request.auth.uid); allow create: if admin() || (teacher() && request.resource.data.actorId == request.auth.uid && request.resource.data.teacherId == request.auth.uid); allow update, delete: if admin() || (teacher() && resource.data.actorId == request.auth.uid && resource.data.teacherId == request.auth.uid); }
    // Public landing-page contact form: anyone (including a signed-out
    // visitor) may create an inquiry, but only with exactly this shape —
    // status locked to 'new', createdAt locked to the server clock, and
    // every status timestamp forced null — so a visitor can never forge an
    // already-read/replied/closed or backdated inquiry. Only Admin/Director
    // may read the list, open one, or change its status; nobody may delete.
    match /contactInquiries/{inquiryId} {
      allow read, update: if admin();
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'role', 'topic', 'message', 'status', 'createdAt', 'readAt', 'repliedAt', 'closedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 200
        && request.resource.data.email is string && request.resource.data.email.size() > 0 && request.resource.data.email.size() <= 200
        && request.resource.data.role is string && request.resource.data.role.size() <= 100
        && request.resource.data.topic is string && request.resource.data.topic.size() <= 100
        && request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 5000
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time
        && request.resource.data.readAt == null && request.resource.data.repliedAt == null && request.resource.data.closedAt == null;
      allow delete: if false;
    }
    // My Shop (formerly the unimplemented "Gift" module). Any signed-in
    // user (Student/Teacher/Volunteer/Admin/Director alike) may browse
    // products; only Admin/Director may create/edit a product or change
    // its stock directly — stock is otherwise only ever decremented
    // server-side, inside a transaction, by /api/shop/checkout, which is
    // why buyers never need a direct products write path at all.
    match /products/{productId} {
      allow read: if signedIn();
      allow write: if admin();
    }
    // No existing category entity anywhere in this schema — one new
    // collection, referenced from `products.categoryId`, is the single
    // source of truth for shop categories. Same read/write shape as
    // `products` itself (any signed-in user can read the live list to
    // render Shop's tabs; only Admin/Director can write).
    match /productCategories/{categoryId} {
      allow read: if signedIn();
      allow write: if admin();
    }
    // Orders are never created directly by a client: decrementing stock
    // and creating the order must happen atomically in one transaction
    // (same reasoning as academyEvents' capacity check), so every order is
    // written server-side by /api/shop/checkout using the Admin SDK. These
    // rules are purely the read/update backstop: Admin/Director see every
    // order (for the "Orders" view inside My Shop); a buyer may only ever
    // read their own; nobody gets a client write path.
    match /orders/{orderId} {
      allow read: if admin() || (signedIn() && resource.data.buyerId == request.auth.uid);
      allow create: if false;
      allow update, delete: if admin();
    }
    // Certificate templates live inside the Achievement module (no separate
    // Certificate collection/module) and are managed by Admin/Director only.
    // Teachers can read them (Certificate Settings needs the active list
    // read-only from the client in a couple of places) but never write.
    // Public certificate verification never reads this collection directly —
    // it goes through app/api/verify/[certificateId] (Admin-SDK proxy), so no
    // signed-out branch is needed here.
    match /certificateTemplates/{templateId} {
      allow read: if admin() || teacher();
      allow write: if admin();
    }
    // Room Booking — the classroom reservation calendar.
    //
    // `rooms` is the single, fully dynamic source of truth for classrooms
    // (there is no fixed 3/4/5 list anywhere): Admin/Director add / edit /
    // deactivate rooms here and the booking filter, the Book-Room form's
    // room dropdown and every calendar column are generated from this
    // collection at runtime. Staff may read it (a Teacher can view the
    // schedule); only Admin/Director may write.
    match /rooms/{roomId} {
      allow read: if admin() || teacher();
      allow create, update: if admin()
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
        && request.resource.data.status in ['active', 'inactive'];
      allow delete: if admin();
    }
    // One booking holds one physical `rooms/{roomId}` for one EXISTING
    // course + class + teacher on one date/time range; courseId / classId /
    // teacherId reference the existing collections (never a duplicate
    // course/class/teacher record). Reads are open to staff; students have
    // no access, matching the app's existing lack of any global schedule
    // view for students. Writes are Admin/Director only and go straight
    // through the client SDK (no server route) so a booking created offline
    // is queued by Firestore's own persistence and syncs on reconnect. A
    // security rule can't query the collection for an overlapping time
    // range, so the double-booking (same room + date + overlapping time)
    // check runs client-side in lib/room-booking-data.js before every write
    // and any collision that still slips through (two people booking while
    // both offline) is surfaced afterwards, never silently accepted.
    match /roomBookings/{bookingId} {
      allow read: if admin() || teacher();
      allow create: if admin()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.roomId is string && request.resource.data.roomId.size() > 0
        && exists(/databases/$(database)/documents/rooms/$(request.resource.data.roomId))
        && request.resource.data.courseId is string && request.resource.data.courseId.size() > 0
        && request.resource.data.classId is string && request.resource.data.classId.size() > 0
        && request.resource.data.teacherId is string && request.resource.data.teacherId.size() > 0
        && request.resource.data.date is string
        && request.resource.data.startTime is string
        && request.resource.data.endTime is string
        && request.resource.data.startTime < request.resource.data.endTime
        && request.resource.data.status == 'scheduled';
      allow update: if admin()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.roomId is string
        && request.resource.data.status in ['scheduled', 'cancelled']
        && request.resource.data.startTime < request.resource.data.endTime;
      allow delete: if admin();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
